<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dms_bubble"
    android:clickable="true"
    android:elevation="8dp"
    android:focusable="false"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Circle Indicator with Dot -->
        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/img_status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_dms_eye" />

            <View
                android:id="@+id/view_badge_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_dot_normal" />
        </FrameLayout>

        <!-- Driver Telemetry Readings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_dms_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DMS Active"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_eye_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="L:95%"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="•"
                    android:textColor="#BDBDBD"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txt_eye_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R:95%"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
